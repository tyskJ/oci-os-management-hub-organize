# バージョン表記: x.y.z（メジャー.マイナー.パッチ）
# 以下のx・y・zは説明用。実際の指定では数値に置き換える。
#
# =  x.y.z : 指定バージョンのみ許可
# != x.y.z : 指定バージョンを除外
# >  x.y.z : 指定バージョンより新しいバージョンを許可
# >= x.y.z : 指定バージョン以上を許可
# <  x.y.z : 指定バージョン未満を許可
# <= x.y.z : 指定バージョン以下を許可
#
# ~> x.y.z : x.y.z以上、x.(y+1).0未満（パッチ更新を許可）
# ~> x.y   : x.y.0以上、(x+1).0.0未満（マイナー・パッチ更新を許可）
#
# カンマ区切りの条件は、すべて満たす必要がある（AND条件）
# >= x.y.z, < a.b.c : x.y.z以上、a.b.c未満を許可
terraform {
  required_version = "~> 1.17.1"

  required_providers {
    oci = {
      source  = "oracle/oci"
      version = "~> 9.0"
    }
  }
}